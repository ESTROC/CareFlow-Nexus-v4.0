# Copy to .env, use strong UNIQUE local values, and never commit .env
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
ADMIN_USERNAME=careflow_admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SEED_DEMO_DATA=true
DEMO_MODE=true
DATABASE_URL=postgresql+psycopg://careflow:replace-database-password@db:5432/careflow
POSTGRES_PASSWORD=replace-database-password
CORS_ORIGINS=http://localhost:5173,http://localhost:8088
# Optional integrations are NOT enabled by default
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Grok (xAI) use https://api.x.ai/v1 and your available grok model.
# Groq (different provider) use https://api.groq.com/openai/v1.
# Uses provider's OpenAI-compatible chat/completions endpoint for bounded read-only tools.
# Set LLM_API_KEY only in .env; never commit it. The demo contains only synthetic cases.
LLM_TIMEOUT_SECONDS=15
LLM_MAX_ROUNDS=3
LLM_MAX_TOOL_CALLS_PER_ROUND=2
# Optional for meaningful cost estimates; otherwise estimated cost is null.
LLM_INPUT_USD_PER_1M_TOKENS=0
LLM_OUTPUT_USD_PER_1M_TOKENS=0
